+  .servizi { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: var(--spazio-l) var(--spazio-m); }
+  .servizi h3 { font-size: 1.125rem; padding-top: var(--spazio-s); border-top: 2px solid var(--petrolio); }
