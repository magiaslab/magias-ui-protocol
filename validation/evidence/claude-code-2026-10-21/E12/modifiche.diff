+  }
+</style>
+</head>
+<body>
+<a class="salta" href="#contenuto">Vai al contenuto</a>
+
+<header class="testata">
+  <div class="contenitore">
+    <span class="marchio">Studio Energia Esempio</span>
+    <nav aria-label="Principale">
+      <ul>
+        <li><a href="#servizi">Servizi</a></li>
+        <li><a href="#casi">Casi</a></li>
+        <li><a href="#contatti">Contatti</a></li>
+      </ul>
+    </nav>
+    <a class="azione" href="#sopralluogo">Richiedi sopralluogo</a>
+  </div>
+</header>
+
+<main id="contenuto">
+  <div class="apertura contenitore">
+    <h1>Riqualificazione energetica per condomini</h1>
+    <p class="introduzione">Siamo uno studio di sei persone. Seguiamo il condominio dalla diagnosi energetica ai lavori, con le pratiche per gli incentivi e l’assistenza in assemblea.</p>
+    <div class="azioni">
+      <a class="azione" href="#sopralluogo">Richiedi un sopralluogo gratuito</a>
+      <a href="#casi">Vedi i casi seguiti</a>
+    </div>
+    <!-- Da verificare con il titolare: fonte e data di aggiornamento dei due numeri. -->
+    <dl class="riscontri">
+      <div><dt>condomini seguiti</dt><dd>Oltre 250</dd></div>
+      <div><dt>famiglie coinvolte</dt><dd>Oltre 12.000</dd></div>
+    </dl>
+  </div>
+
+  <section id="servizi" aria-labelledby="titolo-servizi">
+    <div class="contenitore">
+      <h2 id="titolo-servizi">Servizi</h2>
+      <!-- Descrizioni brevi: copy proposto, da confermare con lo studio. -->
+      <ul class="servizi">
+        <li><h3>Diagnosi energetica</h3><p>Rilievo dell’edificio e dei consumi, con gli interventi possibili in ordine di priorità.</p></li>
+        <li><h3>Cappotto termico</h3><p>Isolamento dell’involucro: scelte tecniche, progetto e controllo in cantiere.</p></li>
+        <li><h3>Impianti</h3><p>Riqualificazione di riscaldamento e produzione di acqua calda.</p></li>
+        <li><h3>Pratiche incentivi</h3><p>Verifica dei requisiti e gestione delle pratiche per le detrazioni.</p></li>
+        <li><h3>Assistenza assemblee</h3><p>Spieghiamo costi, tempi e alternative ai condòmini, in assemblea.</p></li>
+        <li><h3>Monitoraggio consumi</h3><p>Misuriamo i consumi dopo i lavori per verificare il risultato.</p></li>
+      </ul>
+    </div>
+  </section>
+
+  <section id="casi" aria-labelledby="titolo-casi">
+    <div class="contenitore">
+      <h2 id="titolo-casi">Casi seguiti</h2>
+      <p class="nota">Il risparmio dipende dall’edificio e dagli interventi scelti: lo stimiamo dopo la diagnosi. Nel caso migliore seguito finora i consumi sono scesi del 70%.</p>
+      <!-- Per ogni caso: foto reale del cantiere con alt descrittivo, interventi eseguiti, risparmio misurato e periodo di misura. -->
+      <ul class="casi">
+        <li><h3>Via Roma 12</h3></li>
+        <li><h3>Viale dei Pini 4</h3></li>
+        <li><h3>Piazza Centrale 7</h3></li>
+      </ul>
