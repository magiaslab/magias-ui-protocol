+
+<footer class="piede" id="contatti">
+  <div class="contenitore">
+    <h2>Contatti</h2>
+    <!-- Dati di contatto non presenti nel materiale: inserire prima della pubblicazione. -->
+    <address>
+      <p>[Indirizzo dello studio]</p>
+      <p>Telefono: <a href="tel:+390000000000">[numero]</a></p>
+      <p>Email: <a href="mailto:info@example.it">[email]</a></p>
+    </address>
+  </div>
+</footer>
+
+<script>
+  const form = document.querySelector('#sopralluogo form');
+  const messaggi = {
+    nome: 'Inserisci nome e cognome.',
+    email: 'Inserisci un indirizzo email valido, ad esempio nome@dominio.it.',
+    indirizzo: 'Inserisci l’indirizzo del condominio.'
+  };
+  form.addEventListener('submit', (evento) => {
+    let primoErrato = null;
+    for (const [id, testo] of Object.entries(messaggi)) {
+      const campo = form.elements[id];
+      const errore = document.getElementById('errore-' + id);
+      const valido = campo.checkValidity();
+      campo.setAttribute('aria-invalid', String(!valido));
+      errore.textContent = valido ? '' : testo;
+      if (!valido && !primoErrato) primoErrato = campo;
+    }
+    if (primoErrato) {
+      evento.preventDefault();
+      primoErrato.focus();
+      return;
+    }
+    // Evita il doppio invio; i dati restano nei campi.
+    form.querySelector('button[type="submit"]').disabled = true;
+  });
+</script>
+</body>
+</html>
