+      <!-- action da collegare al servizio di invio reale; la conferma va mostrata solo a ricezione avvenuta. -->
+      <form method="post" novalidate>
+        <div class="campo">
+          <label for="nome">Nome e cognome</label>
+          <input type="text" id="nome" name="nome" autocomplete="name" required aria-describedby="errore-nome">
+          <span class="errore" id="errore-nome"></span>
+        </div>
+        <div class="campo">
+          <label for="email">Email</label>
+          <input type="email" id="email" name="email" autocomplete="email" required aria-describedby="errore-email">
+          <span class="errore" id="errore-email"></span>
+        </div>
+        <div class="campo">
+          <label for="telefono">Telefono <span class="facoltativo">(facoltativo)</span></label>
+          <input type="tel" id="telefono" name="telefono" autocomplete="tel">
+        </div>
+        <div class="campo">
+          <label for="indirizzo">Indirizzo del condominio</label>
+          <input type="text" id="indirizzo" name="indirizzo" autocomplete="street-address" required aria-describedby="errore-indirizzo">
+          <span class="errore" id="errore-indirizzo"></span>
+        </div>
+        <div class="campo">
+          <label for="unita">Numero di unità <span class="facoltativo">(facoltativo)</span></label>
+          <input type="number" id="unita" name="unita" min="1" inputmode="numeric" aria-describedby="aiuto-unita">
