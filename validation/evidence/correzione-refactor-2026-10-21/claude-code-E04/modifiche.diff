 'use client'
-import { useEffect, useState } from 'react'
+import { useEffect, useState, useSyncExternalStore } from 'react'
 const FOTO = ['/f/1.webp', '/f/2.webp', '/f/3.webp', '/f/4.webp']
+
+// task_suspension: altri componenti (es. il pannello di prenotazione) sospendono
+// l'autoplay mentre la persona svolge un compito. È distinta dalla pausa manuale:
+// alla fine del compito l'autoplay riprende solo se la persona non l'ha messo in pausa.
+let sospensioni = 0
+const ascoltatori = new Set<() => void>()
+const notifica = () => ascoltatori.forEach((f) => f())
+
+export function useSospensioneCarosello(attiva: boolean) {
+  useEffect(() => {
+    if (!attiva) return
+    sospensioni++
+    notifica()
+    return () => {
+      sospensioni--
+      notifica()
+    }
+  }, [attiva])
+}
+
+function useSospeso() {
+  return useSyncExternalStore(
+    (f) => {
+      ascoltatori.add(f)
+      return () => {
+        ascoltatori.delete(f)
+      }
+    },
+    () => sospensioni > 0,
+    () => false,
+  )
+}
+
+function useMovimentoRidotto() {
+  return useSyncExternalStore(
+    (f) => {
+      const mq = window.matchMedia('(prefers-reduced-motion: reduce)')
+      mq.addEventListener('change', f)
+      return () => mq.removeEventListener('change', f)
+    },
+    () => window.matchMedia('(prefers-reduced-motion: reduce)').matches,
+    () => false,
+  )
+}
+
 export function HeroSlider() {
   const [i, setI] = useState(0)
-  const [inPausa, setInPausa] = useState(false)
+  // undefined = nessuna scelta esplicita: con movimento ridotto l'autoplay parte fermo.
+  const [pausaManuale, setPausaManuale] = useState<boolean>()
+  const ridotto = useMovimentoRidotto()
+  const sospeso = useSospeso()
+  const inPausa = pausaManuale ?? ridotto
   useEffect(() => {
-    if (inPausa) return
+    if (inPausa || sospeso) return
     const t = setInterval(() => setI((n) => (n + 1) % FOTO.length), 6000)
     return () => clearInterval(t)
-  }, [inPausa])
+  }, [inPausa, sospeso])
   return (
     <div className="relative h-[80svh] overflow-hidden" aria-roledescription="carosello" aria-label="Foto della struttura">
-      {FOTO.map((src, n) => <img key={src} src={src} alt="" className={`absolute inset-0 h-full w-full object-cover transition-opacity duration-[1800ms] ${n === i ? 'opacity-100' : 'opacity-0'}`} />)}
-      <button onClick={() => setInPausa((p) => !p)} aria-pressed={inPausa} className="absolute bottom-4 right-4">{inPausa ? 'Riprendi' : 'Pausa'}</button>
+      {FOTO.map((src, n) => <img key={src} src={src} alt="" className={`absolute inset-0 h-full w-full object-cover transition-opacity duration-[1800ms] motion-reduce:transition-none ${n === i ? 'opacity-100' : 'opacity-0'}`} />)}
+      <button onClick={() => setPausaManuale(!inPausa)} aria-pressed={inPausa} className="absolute bottom-4 right-4">{inPausa ? 'Riprendi' : 'Pausa'}</button>
     </div>
   )
 }
