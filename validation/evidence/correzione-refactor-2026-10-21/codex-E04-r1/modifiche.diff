+++ sandbox/E04-r1/materiale/booking-motion.ts	2026-10-21 22:52:41
@@ -0,0 +1,28 @@
+'use client'
+import { useEffect, useSyncExternalStore } from 'react'
+
+// Shared by the overlaid booking panel and the hero, including portalled content.
+const tasks = new Set<symbol>()
+const listeners = new Set<() => void>()
+const notify = () => listeners.forEach((listener) => listener())
+const subscribe = (listener: () => void) => {
+  listeners.add(listener)
+  return () => { listeners.delete(listener) }
+}
+
+export function useBookingTask(active: boolean) {
+  useEffect(() => {
+    if (!active) return
+    const task = Symbol('booking')
+    tasks.add(task)
+    notify()
+    return () => {
+      tasks.delete(task)
+      notify()
+    }
+  }, [active])
+}
+
+export function useBookingSuspended() {
+  return useSyncExternalStore(subscribe, () => tasks.size > 0, () => false)
+}
