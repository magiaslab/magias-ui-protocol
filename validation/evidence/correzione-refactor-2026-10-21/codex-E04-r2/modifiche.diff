@@ -1,18 +1,45 @@
 'use client'
 import { useEffect, useState } from 'react'
+
+// Il pannello può essere un fratello del carosello; l'evento copre anche il popover in portal.
+export const BOOKING_INTERACTION_EVENT = 'booking:interaction'
 const FOTO = ['/f/1.webp', '/f/2.webp', '/f/3.webp', '/f/4.webp']
+
 export function HeroSlider() {
   const [i, setI] = useState(0)
   const [inPausa, setInPausa] = useState(false)
+  const [taskSuspension, setTaskSuspension] = useState(false)
+  const [reducedPreference, setReducedPreference] = useState(true)
+
   useEffect(() => {
-    if (inPausa) return
+    const activePanels = new Set<string>()
+    const onInteraction = (event: Event) => {
+      const { id, active } = (event as CustomEvent<{ id: string; active: boolean }>).detail
+      if (active) activePanels.add(id)
+      else activePanels.delete(id)
+      setTaskSuspension(activePanels.size > 0)
+    }
+    const preference = window.matchMedia('(prefers-reduced-motion: reduce)')
+    const onPreference = () => setReducedPreference(preference.matches)
+    onPreference()
+    preference.addEventListener('change', onPreference)
+    window.addEventListener(BOOKING_INTERACTION_EVENT, onInteraction)
+    return () => {
+      preference.removeEventListener('change', onPreference)
+      window.removeEventListener(BOOKING_INTERACTION_EVENT, onInteraction)
+    }
+  }, [])
+
+  useEffect(() => {
+    if (inPausa || taskSuspension || reducedPreference) return
     const t = setInterval(() => setI((n) => (n + 1) % FOTO.length), 6000)
     return () => clearInterval(t)
-  }, [inPausa])
+  }, [inPausa, taskSuspension, reducedPreference])
+
   return (
     <div className="relative h-[80svh] overflow-hidden" aria-roledescription="carosello" aria-label="Foto della struttura">
-      {FOTO.map((src, n) => <img key={src} src={src} alt="" className={`absolute inset-0 h-full w-full object-cover transition-opacity duration-[1800ms] ${n === i ? 'opacity-100' : 'opacity-0'}`} />)}
-      <button onClick={() => setInPausa((p) => !p)} aria-pressed={inPausa} className="absolute bottom-4 right-4">{inPausa ? 'Riprendi' : 'Pausa'}</button>
+      {FOTO.map((src, n) => <img key={src} src={src} alt="" className={`absolute inset-0 h-full w-full object-cover ${taskSuspension || reducedPreference ? 'transition-none' : 'transition-opacity duration-[1800ms]'} ${n === i ? 'opacity-100' : 'opacity-0'}`} />)}
+      <button type="button" onClick={() => setInPausa((p) => !p)} aria-pressed={inPausa} aria-label={inPausa ? 'Riprendi lo slideshow' : 'Metti in pausa lo slideshow'} className="absolute bottom-4 right-4 min-h-11 rounded bg-black/80 px-4 text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">{inPausa ? 'Riprendi' : 'Pausa'}</button>
     </div>
   )
 }
